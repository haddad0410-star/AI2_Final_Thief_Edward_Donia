# Secrets — must never be committed, must live outside this repo entirely
.env
credentials.json
token.json
client_secret*.json
*.pem
*.key

# Gate A1: tunnel-tool config/credential files — cloudflared/ngrok both
# default to storing these outside any repo, but never trust that by
# omission. PUBLIC_BIND_TOKEN/OPPONENT_MCP_TOKEN themselves are env-var
# only (never written to a file in this repo), so no separate pattern is
# needed for them beyond the .env rule above.
.cloudflared/
ngrok.yml
.ngrok2/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# uv
uv.lock.tmp

# OS
.DS_Store

# Project runtime artifacts (kept locally, not part of source)
logs/*.json
!logs/.gitkeep
reports/**/*.json
reports/**/*.txt
!reports/.gitkeep
