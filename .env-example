# Copy to .env and fill in locally. Never commit the real .env file.

# Role this process runs as (police|thief) — must match this repo.
ROLE=thief

# Absolute path to a directory OUTSIDE both repos containing credentials.json and
# token.json for the Gmail reporter. Never point this inside police_peer/ or
# thief_peer/. Leave unset until Gmail reporting is actually implemented and you have
# completed the OAuth consent flow yourself (Manual Gate C).
GOOGLE_OAUTH_CREDENTIAL_DIR=/absolute/path/outside/both/repos

# Local FastMCP server port for this peer (private; not shared with the opponent).
THIEF_MCP_PORT=8902

# The opponent's MCP URL (the only network detail this peer is given about them).
OPPONENT_MCP_URL=http://127.0.0.1:8901/mcp

LOG_LEVEL=INFO
